  "rules": {
    "D_donor_recognition": "reported first, per donor: JOINT and M of the donor's own ROUND and OK_ALT forwards (does kev-4B read the round field in the donor context)",
    "H_CLS": "#JOINT_round >= 1/2 * #JOINT_main AND dM_main > dM_round in < 60% of cells",
    "H_REL": "(a) #JOINT_round <= 1/4 * #JOINT_main AND (b) dM_main > dM_round in >= 75% of cells and in a majority of cells for >= 10 of 14 donor groups",
    "H_ROLE_ABSTRACT": "#JOINT_okalt >= 1/2 * #JOINT_main -> repair does not hinge on the specific author token; #JOINT_okalt <= 1/4 * #JOINT_main -> author-identity specific; else intermediate",
    "P0_positive_control": "all 112 main patches and the 22 donor-new/host-new captures replay the K-C raw rows bitwise (runner fails closed otherwise)",
    "always_reported": "round vs doserand_r (specific residual of the ROUND span), leave-one-donor-group-out, per host, stratification by donor ROUND self-recognition, all null and negative outcomes",
    "readouts": "M = conflict margin; A = logit(reject_conflict) - max(accept, wait); JOINT = M > 0 and A > 0; dM = M(patch) - M(in-run host capture)",
    "units": "only the 104 cross-group cells (donor group != host group) enter counts; source groups are the unit; cells share donors and hosts, counts are descriptive decision rules, not independent tests",
    "verdict_round": "REL_SUPPORTED if H_REL; CLS_SUPPORTED if H_CLS; else GRADED_INTERMEDIATE"
  },
